# Copy this file to .env. Never commit .env.

# Account that creates and merges the PRs (your main GitHub login)
# Classic token: repo scope
# Fine-grained token: Contents, Pull requests, and Issues read/write
# https://github.com/settings/tokens
GH_TOKEN=

# Pair Extraordinaire: the OTHER GitHub account (not the GH_TOKEN account)
# Use a name and email that GitHub already has on that second account.
# GitHub noreply addresses work, for example:
#   12345678+username@users.noreply.github.com
COAUTHOR_NAME=
COAUTHOR_EMAIL=
